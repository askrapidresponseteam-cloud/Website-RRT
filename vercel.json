{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/pl-api/:path*",
      "destination": "https://www.pets-lifestyle.com/:path*"
    },
    {
      "source": "/manage",
      "destination": "/report/manage"
    },
    {
      "source": "/shop/cart",
      "destination": "/cart"
    },
    {
      "source": "/shop/saved",
      "destination": "/saved"
    },
    {
      "source": "/shop/track",
      "destination": "/track"
    },
    {
      "source": "/shop/track/:path*",
      "destination": "/track"
    },
    {
      "source": "/shop/p/:handle",
      "destination": "/product"
    },
    {
      "source": "/shop/:path*",
      "destination": "/shop"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.rapid-response.in"
        }
      ],
      "destination": "https://rapid-response.in/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/how-it-works",
      "destination": "/",
      "permanent": true
    }
  ]
}

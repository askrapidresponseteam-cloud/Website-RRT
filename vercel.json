{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/st-api/collections/:handle/products.json",
      "destination": "https://supertails.com/collections/:handle/products.json"
    },
    {
      "source": "/st-api/products/:file([^/]+\\.js)",
      "destination": "https://supertails.com/products/:file"
    },
    {
      "source": "/st-api/search/suggest.json",
      "destination": "https://supertails.com/search/suggest.json"
    },
    {
      "source": "/st-api/recommendations/products.json",
      "destination": "https://supertails.com/recommendations/products.json"
    },
    {
      "source": "/pl-api/collections/:handle/products.json",
      "destination": "https://www.pets-lifestyle.com/collections/:handle/products.json"
    },
    {
      "source": "/pl-api/products/:file([^/]+\\.js)",
      "destination": "https://www.pets-lifestyle.com/products/:file"
    },
    {
      "source": "/pl-api/search/suggest.json",
      "destination": "https://www.pets-lifestyle.com/search/suggest.json"
    },
    {
      "source": "/pl-api/recommendations/products.json",
      "destination": "https://www.pets-lifestyle.com/recommendations/products.json"
    },
    {
      "source": "/manage",
      "destination": "/report/manage"
    },
    {
      "source": "/shop/cart",
      "destination": "/cart"
    },
    {
      "source": "/shop/saved",
      "destination": "/saved"
    },
    {
      "source": "/shop/track",
      "destination": "/track"
    },
    {
      "source": "/shop/track/:path*",
      "destination": "/track"
    },
    {
      "source": "/shop/p/:handle",
      "destination": "/product"
    },
    {
      "source": "/shop/:path*",
      "destination": "/shop"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self), payment=(), usb=(), serial=(), hid=(), midi=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/fonts/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/vendor/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/st-api/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/pl-api/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/how-it-works",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/legal-desk",
      "destination": "/know-the-laws",
      "permanent": true
    }
  ]
}

{
  "hosting": {
    "target": "web",
    "public": "dist",
    "predeploy": [
      "npm run build"
    ],
    "cleanUrls": true,
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/report",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/how-it-works",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/legal-desk",
        "destination": "/know-the-laws",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/st-api/**",
        "function": {
          "functionId": "webStoreProxy",
          "region": "asia-south1"
        }
      },
      {
        "source": "/pl-api/**",
        "function": {
          "functionId": "webStoreProxy",
          "region": "asia-south1"
        }
      },
      {
        "source": "/huft-api/**",
        "function": {
          "functionId": "webStoreProxy",
          "region": "asia-south1"
        }
      },
      {
        "source": "/zg-api/**",
        "function": {
          "functionId": "webStoreProxy",
          "region": "asia-south1"
        }
      },
      {
        "source": "/pt-api/**",
        "function": {
          "functionId": "webStoreProxy",
          "region": "asia-south1"
        }
      },
      {
        "source": "/jd-api/**",
        "function": {
          "functionId": "webStoreProxy",
          "region": "asia-south1"
        }
      },
      {
        "source": "/wk-api/**",
        "function": {
          "functionId": "webStoreProxy",
          "region": "asia-south1"
        }
      },
      {
        "source": "/r/*",
        "destination": "/invite.html"
      },
      {
        "source": "/manage",
        "destination": "/report/manage.html"
      },
      {
        "source": "/shop/cart",
        "destination": "/cart.html"
      },
      {
        "source": "/shop/saved",
        "destination": "/saved.html"
      },
      {
        "source": "/shop/track",
        "destination": "/track.html"
      },
      {
        "source": "/shop/track/**",
        "destination": "/track.html"
      },
      {
        "source": "/shop/p/*",
        "destination": "/product.html"
      },
      {
        "source": "/shop/**",
        "destination": "/shop.html"
      }
    ],
    "headers": [
      {
        "regex": "^/(?:[^/]{0,3}|[^/]*(?:[^/]{3}[^i/]|[^/]{2}[^p/]i|[^/][^a/]pi|[^-/]api))(?:/.*)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/app-demo",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/app-demo.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(self), geolocation=(self), payment=(), usb=(), serial=(), hid=(), midi=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000"
          },
          {
            "key": "Content-Security-Policy",
            "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
          },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: blob:; media-src 'self' blob: https://firebasestorage.googleapis.com; connect-src 'self' https://content-firebaseappcheck.googleapis.com https://www.google.com/recaptcha/ https://asia-south1-rrt-new-backend.cloudfunctions.net https://asia-south1-report-5bf7e.cloudfunctions.net https://firestore.googleapis.com https://firebasestorage.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com https://api.bigdatacloud.net https://is.gd https://supertails.com https://www.pets-lifestyle.com https://08e8df.myshopify.com https://headsupfortails.com https://zigly.com https://zigly-store.myshopify.com https://pawsandtails24.com https://www.justdogsstore.com https://whiskeepetzone.com; frame-src 'self' https://rrt-new-backend.firebaseapp.com https://report-5bf7e.firebaseapp.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'"
          }
        ]
      },
      {
        "source": "/assets/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/assets/vendor/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/st-api/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/pl-api/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/huft-api/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/zg-api/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/pt-api/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/jd-api/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source": "/wk-api/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions-web",
      "codebase": "web",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "*.test.js",
        "*.md"
      ]
    }
  ]
}
